<form class="actor-sheet {{classes}} m-0" autocomplete="off">
    {{#if config.enableTinyD6Plus}}
    <div class="td-rail" role="tablist">
        <button type="button" class="td-rail-tab active" data-rail="sheet" title="{{localize "tinyd6.mech.sheet"}}"><i class="fas fa-scroll"></i></button>
        <button type="button" class="td-rail-tab" data-rail="mechanics" title="{{localize "tinyd6.mech.mechanics"}}"><i class="fas fa-gear"></i></button>
    </div>
    {{/if}}
    <div class="td-sheet-body">
    <div class="td-hero-head">
        <div class="td-avatar"><img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" alt=""/></div>
        <div class="td-who">
            <h1>{{actor.name}}</h1>
            <div class="td-sub">{{#if data.system.heritage}}{{data.system.heritage.name}}{{/if}}{{#if data.system.familyTrade}} · {{data.system.familyTrade}}{{/if}}{{#if data.system.belief}} · {{data.system.belief}}{{/if}}</div>
        </div>
        <div class="td-stats">
            {{> "systems/tinyd6v14/templates/partials/action-tracker.hbs"}}
            <div class="td-stat"><div class="n" data-live="wounds">{{data.system.wounds.value}}/{{data.system.wounds.max}}</div><div class="c">{{localize "tinyd6.sheet.wounds"}}</div></div>
            <div class="td-stat"><div class="n">{{data.system.armorTotal}}</div><div class="c">{{localize "tinyd6.sheet.armor"}}</div></div>
            {{#if config.enableCorruption}}
            <div class="td-stat"><div class="n" data-live="corruption">{{data.system.corruptionThreshold.value}}</div><div class="c">{{localize "tinyd6.sheet.corruption"}}</div></div>
            {{/if}}
            {{#if (eq config.advancementMethod 'xp')}}
            <div class="td-stat"><div class="n" data-live="xp">{{data.system.xp.remaining}}</div><div class="c">{{localize "tinyd6.sheet.xp"}}</div></div>
            {{/if}}
        </div>
    </div>

    <div class="td-tabs">
        <button type="button" class="td-tab active" data-tab="main">{{localize "tinyd6.sheet.tab.main"}}</button>
        <button type="button" class="td-tab" data-tab="traits">{{localize "tinyd6.actor.traits"}}</button>
        <button type="button" class="td-tab" data-tab="inventory">{{localize "tinyd6.actor.gear"}}</button>
    </div>

    {{#if owner}}
        {{> "systems/tinyd6v14/templates/partials/roll-bar.hbs" flexClass=""}}
    {{/if}}

    <div class="td-pane active" data-pane="main">
        <div class="folk-bg folk-bg-hero" aria-hidden="true"></div>
        <section class="character">
            <h1 class="floating-header">{{localize config.characterHeaderPath}}</h1>
            <div class="bio-box">
                <div class="row">
                    <div class="col td6-stat-values">
                        <div class="name property d-flex justify-content-between td6-border-bottom">
                            <label><span>{{localize "tinyd6.actor.name"}}</span></label>
                            <input name="name" type="text" class="text-right" value="{{actor.name}}" placeholder="{{localize "tinyd6.actor.name"}}"/>
                        </div>
                        <div class="heritage property d-flex justify-content-between td6-border-bottom" data-item-id="{{data.system.heritage._id}}">
                            <label><span>{{localize config.heritageHeaderPath}}</span></label>
                            <div class="heritage-value ml-auto">
                                <a class="item-show d-inline-block h-100">{{data.system.heritage.name}}</a>
                            </div>
                            {{#if data.system.heritage}}
                                <a class="item-control item-delete ml-2 my-auto" title="{{localize config.heritageDeleteTooltipPath}}"><i class="fas fa-times"></i></a>
                            {{/if}}
                        </div>
                        <div class="family-trade property d-flex justify-content-between td6-border-bottom">
                            <label class="text-nowrap"><span>{{localize "tinyd6.actor.familyTrade"}}</span></label>
                            <input name="system.familyTrade" type="text" class="text-right" value="{{data.system.familyTrade}}" placeholder="{{localize "tinyd6.actor.familyTrade"}}"/>
                        </div>
                        <div class="belief property">
                            <label class="td6-border-bottom"><span>{{localize "tinyd6.actor.belief"}}</span></label>
                            <input name="system.belief" type="text" value="{{data.system.belief}}" placeholder="{{localize "tinyd6.actor.belief"}}"/>
                        </div>
                    </div>
                    <div class="col-3 pt-3 text-center">
                        <img src="{{actor.img}}" data-edit="img" title="{{actor.name}}" class="character-art img-fluid"/>
                    </div>
                </div>
                <div class="td6-stat-values">
                    <div class="description property">
                        <label class="td6-border-bottom"><span>{{localize "tinyd6.actor.description"}}</span></label>
                        {{editor descriptionHTML target="system.description" button=true owner=owner editable=editable}}
                    </div>
                </div>
            </div>
        </section>

        <section class="combat-blend">
            <h2 class="floating-header">{{localize "tinyd6.sheet.combat"}}</h2>
            <div class="combat-grid">
                <div class="combat-health">
                    <section class="trauma">
                        <div class="row">
                            <div class="col">
                                <div class="d-flex justify-content-between">
                                    <h2 class="td6-section-header">{{localize "tinyd6.actor.wounds.header"}}</h2>
                                    <span class="d-flex justify-content-end ml-auto">
                                        <span class="mr-2">{{localize "tinyd6.actor.wounds.max"}}</span>
                                        {{#if owner}}
                                            <input name="system.wounds.max" type="text" class="mx-2" style="width: 10%;" value="{{data.system.wounds.max}}" data-dtype="Number"/>
                                        {{^}}
                                            <span>{{data.system.wounds.max}}</span>
                                        {{/if}}
                                    </span>
                                </div>
                <div class="health-meter">
                                    {{#times data.system.wounds.max}}
                                        <input type="checkbox" value="1" class="health-box d-inline-block" {{#if (lt . ../data.system.wounds.value)}}checked{{/if}} />
                                    {{/times}}
                                </div>
                                {{#if owner}}
                                    <p class="help">{{localize "tinyd6.actor.wounds.help"}}</p>
                                {{/if}}
                                {{#if config.enableTinyD6Plus}}
                                <div class="stab-action">
                                    <div class="icon">{{{td6icon "kit-medical"}}}</div>
                                    <div class="stab-action-body">
                                        <div class="t">{{localize "tinyd6.stabilize.title"}}</div>
                                        <div class="d">{{localize "tinyd6.stabilize.sheetHint"}}</div>
                                    </div>
                                    <button type="button" class="stab-btn" data-action="stabilize">
                                        {{{td6icon "burst"}}} {{localize "tinyd6.stabilize.title"}}
                                    </button>
                                </div>
                                {{/if}}
                            </div>
                            {{#if config.enableCorruption}}
                                <div class="col">
                                    <div class="d-flex justify-content-between">
                                        <h2 class="td6-section-header">{{localize "tinyd6.actor.corruption.header"}}</h2>
                                        <span class="d-flex justify-content-end ml-auto">
                                            <span class="mr-2">{{localize "tinyd6.actor.corruption.max"}}</span>
                                            {{#if owner}}
                                                <input name="system.corruptionThreshold.max" type="text" class="mx-2" style="width: 10%;" value="{{data.system.corruptionThreshold.max}}" data-dtype="Number"/>
                                            {{^}}
                                                <span>{{data.system.corruptionThreshold.max}}</span>
                                            {{/if}}
                                        </span>
                                    </div>
                                    <div class="corruption-meter">
                                        {{#times data.system.corruptionThreshold.max}}
                                            <input type="checkbox" value="1" class="corruption-box d-inline-block" {{#if (lt . ../data.system.corruptionThreshold.value)}}checked{{/if}} />
                                        {{/times}}
                                    </div>
                                    {{#if owner}}
                                        <p class="help">{{localize "tinyd6.actor.corruption.help"}}</p>
                                    {{/if}}
                                </div>
                            {{/if}}
                            {{#if (eq config.advancementMethod 'xp')}}
                                <div class="col-3">
                                    <section class="experience d-flex flex-column justify-content-between">
                                        <h3 class="td6-section-header">{{localize "tinyd6.actor.xp.header"}}</h3>
                                        <div class="td6-stat-values property d-flex justify-content-between td6-border-bottom">
                                            <label class="mr-2"><span>{{localize "tinyd6.actor.xp.total"}}</span></label>
                                            <input name="system.xp.max" class="text-right" type="text" value="{{data.system.xp.max}}" placeholder="{{localize "tinyd6.actor.xp.total"}}" data-dtype="Number"/>
                                        </div>
                                        <div class="td6-stat-values property d-flex justify-content-between td6-border-bottom">
                                            <label class="mr-2"><span>{{localize "tinyd6.actor.xp.spent"}}</span></label>
                                            <input name="system.xp.spent" class="text-right" type="text" value="{{data.system.xp.spent}}" placeholder="{{localize "tinyd6.actor.xp.spent"}}" data-dtype="Number"/>
                                        </div>
                                        <div class="td6-stat-values property d-flex justify-content-between td6-border-bottom">
                                            <label class="mr-2"><span>{{localize "tinyd6.actor.xp.remaining"}}</span></label>
                                            <span class="d-block">
                                                {{data.system.xp.remaining}}
                                            </span>
                                        </div>
                                    </section>
                                </div>
                            {{/if}}
                            {{#if (eq config.advancementMethod 'minimalist')}}
                                <div class="col-3">
                                    <section class="experience d-flex flex-column justify-content-between">
                                        <h3 class="td6-section-header">{{localize "tinyd6.actor.xp.progression"}}</h3>
                                        <div class="d-flex">
                                            {{#times data.system.advancement.max}}
                                                <input type="checkbox" value="1" class="advancement-progress-box d-inline-block" {{#if (lt . ../data.system.advancement.value)}}checked{{/if}} />
                                            {{/times}}
                                        </div>
                                    </section>
                                </div>
                            {{/if}}
                        </div>
                    </section>
                </div>
                <div class="combat-profs">
                    <section class="proficiencies">
                        <h2 class="td6-section-header">{{localize "tinyd6.sheet.weaponProficiency"}}</h2>
                        <div class="d-flex justify-content-start">
                            <div class="light mr-4">
                                <label>
                                    <input type="checkbox" name="system.proficiencies.lightMelee" {{checked data.system.proficiencies.lightMelee}}/>
                                    {{localize "tinyd6.weapon.lightMelee"}}
                                </label>
                            </div>
                            <div class="heavy mr-4">
                                <label>
                                    <input type="checkbox" name="system.proficiencies.heavyMelee" {{checked data.system.proficiencies.heavyMelee}}/>
                                    {{localize "tinyd6.weapon.heavyMelee"}}
                                </label>
                            </div>
                            <div class="ranged mr-4">
                                <label>
                                    <input type="checkbox" name="system.proficiencies.lightRanged" {{checked data.system.proficiencies.lightRanged}}/>
                                    {{localize "tinyd6.weapon.lightRanged"}}
                                </label>
                            </div>
                            <div class="ranged mr-4">
                                <label>
                                    <input type="checkbox" name="system.proficiencies.heavyRanged" {{checked data.system.proficiencies.heavyRanged}}/>
                                    {{localize "tinyd6.weapon.heavyRanged"}}
                                </label>
                            </div>
                        </div>
                        {{#if config.enableTinyD6Plus}}
                        <div class="mastered-slots">
                            {{#each data.system.masteredSlots as |slot idx|}}
                                <div class="mastered-slot" data-slot="{{idx}}">
                                    <span class="mastered-slot-label"><i class="fas fa-crosshairs"></i> {{localize "tinyd6.actor.proficiencies.mastered"}}</span>
                                    <button type="button" class="mastered-weapon-picker" data-action="openMasteredWeaponSelector">
                                        {{#if slot.name}}
                                            {{slot.name}}
                                        {{else}}
                                            {{localize "tinyd6.sheet.none"}}
                                        {{/if}}
                                    </button>
                                    {{#if slot.name}}
                                        <a class="mastered-slot-clear" title="{{localize "tinyd6.sheet.delete"}}"><i class="fas fa-xmark"></i></a>
                                    {{/if}}
                                </div>
                            {{/each}}
                        </div>
                        {{else}}
                        <div class="d-flex justify-content-start mt-2">
                            <label class="mr-2"><h3 class="td6-section-header">{{localize "tinyd6.actor.proficiencies.mastered"}}</h3></label>
                            <button type="button" class="mastered-weapon-picker" data-action="openMasteredWeaponSelector">
                                {{#if data.system.masteredWeaponName}}
                                    {{data.system.masteredWeaponName}}
                                {{else}}
                                    {{localize "tinyd6.sheet.none"}}
                                {{/if}}
                            </button>
                        </div>
                        {{/if}}
                    </section>
                </div>
            </div>
        </section>

        <section class="archetype-block">
            <h2 class="floating-header">{{localize config.heritageHeaderPath}}</h2>
            <div class="archetype-body" data-item-id="{{data.system.heritage._id}}">
                {{#if data.system.heritage}}
                <div class="archetype-head d-flex align-items-start">
                    <img src="{{data.system.heritage.img}}" title="{{data.system.heritage.name}}" alt="" width="40" height="40" class="align-middle mr-2"/>
                    <h3 class="archetype-name mr-auto"><a class="item-show d-inline-block">{{data.system.heritage.name}}</a></h3>
                    <a class="item-chat mx-1" title="{{localize "tinyd6.actor.actions.chatTrait"}}"><i class="fas fa-comment-dots"></i></a>
                </div>
                <div class="archetype-trait">
                    {{{data.system.heritage.system.trait}}}
                    {{#unless data.system.heritage.system.trait}}
                        {{{data.system.heritage.system.description}}}
                    {{/unless}}
                </div>
                {{else}}
                <p class="archetype-empty">{{localize "tinyd6.sheet.none"}}</p>
                {{/if}}
            </div>
        </section>
    </div>

    <div class="td-pane" data-pane="traits">
        <div class="folk-bg folk-bg-dragon" aria-hidden="true"></div>
        <section class="traits">
            <h2 class="floating-header">{{localize "tinyd6.actor.traits"}}</h2>
            <div class="floating-action">
                <a class="item-add" data-type="trait">
                    <span class="fas fa-plus"></span>
                </a>
            </div>
            <div class="heritage-trait td6-border-bottom">
                <h3>{{localize config.heritageTraitPath}}</h3>
                {{#if data.system.heritage.system.trait}}
                    {{{data.system.heritage.system.trait}}}
                {{^}}
                    {{{data.system.heritage.system.description}}}
                {{/if}}
            </div>
            <ul class="actor-items px-0">
                {{#each data.system.traits as |trait id|}}
                    {{> "systems/tinyd6v14/templates/partials/trait-block.hbs" trait}}
                {{/each}}
            </ul>
        </section>
    </div>

    <div class="td-pane" data-pane="inventory">
        <div class="folk-bg folk-bg-dragon" aria-hidden="true"></div>
        <section class="inventory">
            <h2 class="floating-header">{{localize "tinyd6.actor.gear"}}</h2>

            <section class="inventory-currency">
                <div class="inv-section-toggle" data-section="currency">
                    <span class="arrow">&#9660;</span> {{localize 'tinyd6.actor.money'}}
                </div>
                <div class="inv-section-body">
                    <div class="inv-currency-wrap count-{{data.system.currencies.length}}">
                        {{#each data.system.currencies as |currency id|}}
                            <div class="inv-currency-item" data-item-id="{{currency._id}}">
                                <img class="inv-currency-img" src="{{currency.img}}" alt=""/>
                                <span class="inv-currency-name">{{currency.name}}</span>
                                <input class="currency-input" type="number" min="0" value="{{currency.system.quantity.value}}" data-field="system.quantity.value" data-item-id="{{currency._id}}"/>
                                <a class="inv-row-btn delete" title="{{localize 'tinyd6.sheet.delete'}}" data-item-id="{{currency._id}}"><i class="fas fa-xmark"></i></a>
                            </div>
                        {{/each}}
                        {{#unless data.system.currencies}}
                            <div class="inv-empty">{{localize 'tinyd6.actor.noMoney'}}</div>
                        {{/unless}}
                    </div>
                </div>
            </section>

            <section class="inventory-weapons inv-collapsible">
                <div class="inv-section-toggle" data-section="weapons">
                    <span class="arrow">&#9660;</span> {{localize 'tinyd6.actor.equipment'}}
                    <span class="inv-section-count">{{data.system.weapons.length}}</span>
                </div>
                <div class="inv-section-body">
                    {{#each data.system.weapons as |weapon id|}}
                        <div class="inv-row" data-item-id="{{weapon._id}}">
                            <img class="inv-row-img" src="{{weapon.img}}" alt=""/>
                            <span class="inv-row-name">{{weapon.name}}</span>
                            {{#if weapon.system.reload}}
                                <span class="inv-row-charges {{#if (eq weapon.system.charges 0)}}empty{{/if}}">
                                    <input class="inline-num" type="number" min="0" max="{{weapon.system.uses}}" value="{{weapon.system.charges}}" data-field="system.charges" data-item-id="{{weapon._id}}"/>
                                    <span class="inline-sep">/</span><span class="inline-max">{{weapon.system.uses}}</span>
                                </span>
                                <a class="inv-row-btn weapon-reload" title="{{localize 'tinyd6.Reload'}}" data-weapon-id="{{weapon._id}}"><i class="fas fa-rotate"></i></a>
                            {{/if}}
                            {{#if (or (eq weapon.system.damageType "light") (eq weapon.system.weaponType "lightMelee") (eq weapon.system.weaponType "lightRanged"))}}
                                <span class="inv-row-tag">L</span>
                            {{else if (or (eq weapon.system.damageType "heavy") (eq weapon.system.weaponType "heavyMelee") (eq weapon.system.weaponType "heavyRanged"))}}
                                <span class="inv-row-tag">H</span>
                            {{/if}}
                            <a class="inv-row-btn attack" title="{{localize 'tinyd6.attack.attack'}}" data-weapon-id="{{weapon._id}}"><i class="fas fa-crosshairs"></i></a>
                            <a class="inv-row-btn item-equip" title="{{localize 'tinyd6.sheet.unequip'}}" data-item-id="{{weapon._id}}"><i class="fas fa-arrow-right-from-bracket"></i></a>
                        </div>
                    {{/each}}
                </div>
            </section>

            <section class="inventory-armor inv-collapsible">
                <div class="inv-section-toggle" data-section="armor">
                    <span class="arrow">&#9660;</span> {{localize 'tinyd6.armor.armor'}}
                    <span class="inv-section-count">{{add data.system.armor.length data.system.shields.length}}</span>
                </div>
                <div class="inv-section-body">
                    <div class="inv-armor-wrap">
                        <div class="inv-armor-list">
                            {{#each data.system.armor as |armor id|}}
                                <div class="inv-row" data-item-id="{{armor._id}}">
                                    <img class="inv-row-img" src="{{armor.img}}" alt=""/>
                                    <span class="inv-row-name">{{armor.name}}</span>
                                    <span class="inv-row-stats">DR:{{armor.system.damageReduction}}</span>
                                    <a class="inv-row-btn item-equip" title="{{localize 'tinyd6.sheet.unequip'}}" data-item-id="{{armor._id}}"><i class="fas fa-arrow-right-from-bracket"></i></a>
                                </div>
                            {{/each}}
                            {{#each data.system.shields as |shield id|}}
                                <div class="inv-row inv-row-shield" data-item-id="{{shield._id}}">
                                    <img class="inv-row-img" src="{{shield.img}}" alt=""/>
                                    <span class="inv-row-name">{{shield.name}}</span>
                                    <span class="inv-row-stats">DR:{{shield.system.damageReduction}}</span>
                                    <span class="inv-row-charges {{#if (eq shield.system.armorHp.value 0)}}empty{{/if}}">
                                        <input class="inline-num" type="number" min="0" max="{{shield.system.armorHp.max}}" value="{{shield.system.armorHp.value}}" data-field="system.armorHp.value" data-item-id="{{shield._id}}"/>
                                        <span class="inline-sep">/</span><span class="inline-max">{{shield.system.armorHp.max}}</span>
                                    </span>
                                    <a class="inv-row-btn item-equip" title="{{localize 'tinyd6.sheet.unequip'}}" data-item-id="{{shield._id}}"><i class="fas fa-arrow-right-from-bracket"></i></a>
                                </div>
                            {{/each}}
                            {{#unless data.system.armor}}
                                {{#unless data.system.shields}}
                                    <div class="inv-empty">{{localize 'tinyd6.armor.none'}}</div>
                                {{/unless}}
                            {{/unless}}
                        </div>
                        <div class="inv-armor-block">
                            <div class="total-armor">{{data.system.armorTotal}}</div>
                            <div class="armor-hprow">
                                <input class="armor-hp-input" type="number" min="0" value="{{data.system.armorHpTotal}}" title="{{localize 'tinyd6.armor.armorHp'}}"/>
                                <button type="button" class="armor-restore" data-tooltip="TINYD6.ArmorRestore" data-tooltip-direction="UP">
                                    <i class="fas fa-arrows-rotate"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="inventory-gear inv-collapsible">
                <div class="inv-section-toggle" data-section="gear">
                    <span class="arrow">&#9660;</span> {{localize 'tinyd6.actor.gear'}}
                    <span class="inv-section-count">{{data.system.nonMoneyGear.length}}</span>
                </div>
                <div class="inv-section-body">
                    <div class="inv-gear-grid">
                        {{#each data.system.nonMoneyGear as |gearItem id|}}
                            {{#if (or (eq gearItem.type "weapon") (eq gearItem.type "armor"))}}
                                <div class="inv-row" data-item-id="{{gearItem._id}}">
                                    <img class="inv-row-img" src="{{gearItem.img}}" alt=""/>
                                    <span class="inv-row-name">{{gearItem.name}}</span>
                                    <a class="inv-row-btn item-equip" title="{{localize 'tinyd6.actor.equipped'}}" data-item-id="{{gearItem._id}}"><i class="fas fa-arrow-right-to-bracket"></i></a>
                                    <a class="inv-row-btn delete" title="{{localize 'tinyd6.sheet.delete'}}" data-item-id="{{gearItem._id}}"><i class="fas fa-xmark"></i></a>
                                </div>
                            {{else}}
                                {{#if (eq gearItem.system.category "heal")}}
                                    <div class="inv-row heal-row {{#if (eq gearItem.system.quantity.value 0)}}zero-qty{{/if}}" data-item-id="{{gearItem._id}}">
                                        <img class="inv-row-img" src="{{gearItem.img}}" alt=""/>
                                        <span class="inv-row-name {{#if (eq gearItem.system.quantity.value 0)}}strikethrough{{/if}}">{{gearItem.name}}</span>
                                        <span class="heal-badge" title="{{localize 'tinyd6.gear.heal'}}">{{gearItem.system.heal}}</span>
                                        <span class="inv-row-qty">
                                            <input class="inline-num" type="number" min="0" value="{{gearItem.system.quantity.value}}" data-field="system.quantity.value" data-item-id="{{gearItem._id}}"/>
                                        </span>
                                        <a class="inv-row-btn delete" title="{{localize 'tinyd6.sheet.delete'}}" data-item-id="{{gearItem._id}}"><i class="fas fa-xmark"></i></a>
                                    </div>
                                {{else}}
                                    <div class="inv-row {{#if (eq gearItem.system.quantity.value 0)}}zero-qty{{/if}}" data-item-id="{{gearItem._id}}">
                                        <img class="inv-row-img" src="{{gearItem.img}}" alt=""/>
                                        <span class="inv-row-name {{#if (eq gearItem.system.quantity.value 0)}}strikethrough{{/if}}">{{gearItem.name}}</span>
                                        <span class="inv-row-qty">
                                            <input class="inline-num" type="number" min="0" value="{{gearItem.system.quantity.value}}" data-field="system.quantity.value" data-item-id="{{gearItem._id}}"/>
                                        </span>
                                        <a class="inv-row-btn delete" title="{{localize 'tinyd6.sheet.delete'}}" data-item-id="{{gearItem._id}}"><i class="fas fa-xmark"></i></a>
                                    </div>
                                {{/if}}
                            {{/if}}
                        {{/each}}
                    </div>
                </div>
            </section>

        </section>
    </div>

    {{#if config.enableTinyD6Plus}}
    <div class="td-pane td-pane-mechanics" data-pane="mechanics">
        <h2 class="floating-header">{{localize "tinyd6.mech.mechanics"}}</h2>

        <section class="mech-section">
            <h3 class="td6-section-header">{{localize "tinyd6.mech.actions"}}</h3>
            <div class="mech-row">
                <label>{{localize "tinyd6.mech.actionsMax"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="number" min="0" data-path="system.actions.max" value="{{data.system.actions.max}}"/>
                {{else}}
                    <span>{{data.system.actions.max}}</span>
                {{/if}}
            </div>
            <div class="mech-row">
                <label>{{localize "tinyd6.mech.woundsMax"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="number" min="1" data-path="system.wounds.max" value="{{data.system.wounds.max}}"/>
                {{else}}
                    <span>{{data.system.wounds.max}}</span>
                {{/if}}
            </div>
            {{#if config.enableCorruption}}
            <div class="mech-row">
                <label>{{localize "tinyd6.mech.corruptionMax"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="number" min="1" data-path="system.corruptionThreshold.max" value="{{data.system.corruptionThreshold.max}}"/>
                {{else}}
                    <span>{{data.system.corruptionThreshold.max}}</span>
                {{/if}}
            </div>
            {{/if}}
            {{#if (eq config.advancementMethod 'xp')}}
            <div class="mech-row">
                <label>{{localize "tinyd6.actor.xp.total"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="number" min="0" data-path="system.xp.max" value="{{data.system.xp.max}}"/>
                {{else}}
                    <span>{{data.system.xp.max}}</span>
                {{/if}}
            </div>
            {{/if}}
            {{#if (eq config.advancementMethod 'minimalist')}}
            <div class="mech-row">
                <label>{{localize "tinyd6.actor.xp.progression"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="number" min="1" data-path="system.advancement.max" value="{{data.system.advancement.max}}"/>
                {{else}}
                    <span>{{data.system.advancement.max}}</span>
                {{/if}}
            </div>
            {{/if}}
        </section>

        <section class="mech-section">
            <h3 class="td6-section-header">{{localize "tinyd6.actor.proficiencies.mastered"}}</h3>
            <div class="mech-row">
                <label>{{localize "tinyd6.mech.masteredCount"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="number" min="1" max="6" data-path="system.homebrew.masteredCount" value="{{data.system.homebrew.masteredCount}}"/>
                {{else}}
                    <span>{{data.system.homebrew.masteredCount}}</span>
                {{/if}}
            </div>
            <p class="mech-hint">{{localize "tinyd6.mech.masteredHint"}}</p>
        </section>

        <section class="mech-section">
            <h3 class="td6-section-header">{{localize "tinyd6.mech.death"}}</h3>
            <div class="mech-row">
                <label>{{localize "tinyd6.mech.deathDie"}}</label>
                {{#if owner}}
                    <select data-path="system.homebrew.deathDie">
                        <option value="" {{#unless data.system.homebrew.deathDie}}selected{{/unless}}>d6 ({{localize "tinyd6.mech.worldDefault"}})</option>
                        <option value="d4" {{#if (eq data.system.homebrew.deathDie "d4")}}selected{{/if}}>d4</option>
                        <option value="d6" {{#if (eq data.system.homebrew.deathDie "d6")}}selected{{/if}}>d6</option>
                        <option value="d8" {{#if (eq data.system.homebrew.deathDie "d8")}}selected{{/if}}>d8</option>
                        <option value="d10" {{#if (eq data.system.homebrew.deathDie "d10")}}selected{{/if}}>d10</option>
                    </select>
                {{else}}
                    <span>{{data.system.homebrew.deathDie}}</span>
                {{/if}}
            </div>
            <div class="mech-row">
                <label>{{localize "tinyd6.mech.deathRounds"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="text" inputmode="text" data-path="system.homebrew.deathRounds" value="{{data.system.homebrew.deathRounds}}" placeholder="{{localize "tinyd6.mech.worldDefault"}}"/>
                {{else}}
                    <span>{{data.system.homebrew.deathRounds}}</span>
                {{/if}}
            </div>
            <div class="mech-row">
                <label>{{localize "tinyd6.mech.deathThreshold"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="number" min="1" max="10" data-path="system.homebrew.deathSaveThreshold" value="{{data.system.homebrew.deathSaveThreshold}}" placeholder="{{localize "tinyd6.mech.worldDefault"}}"/>
                {{else}}
                    <span>{{data.system.homebrew.deathSaveThreshold}}</span>
                {{/if}}
            </div>
            <p class="mech-hint">{{localize "tinyd6.mech.emptyWorld"}}</p>
        </section>

        <section class="mech-section">
            <h3 class="td6-section-header">{{localize "tinyd6.mech.damageBonus"}}</h3>
            <div class="mech-row">
                <label>{{localize "tinyd6.mech.damageBonus"}}</label>
                {{#if owner}}
                    <input class="inline-num" type="number" min="0" max="20" data-path="system.homebrew.damageBonus" value="{{data.system.homebrew.damageBonus}}"/>
                {{else}}
                    <span>{{data.system.homebrew.damageBonus}}</span>
                {{/if}}
            </div>
            <p class="mech-hint">{{localize "tinyd6.mech.damageBonusHint"}}</p>
        </section>
    </div>
    {{/if}}
    </div>
</form>
