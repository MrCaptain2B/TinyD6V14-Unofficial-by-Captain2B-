{{!-- weapon-sheet-v2.hbs — полностью автономный шаблон оружия.
     Не использует item-header.hbs, весь layout от самого начала. --}}
<form class="weapon-sheet-v2" autocomplete="off">
    {{!-- === ШАПКА: иконка + имя (без .sheet-header, без partial) === --}}
    <header class="ws-header">
        <img class="ws-avatar" src="{{item.img}}" data-edit="img"
             title="{{item.name}}" alt="{{item.name}}" height="64" width="64"/>
        <input class="ws-name" name="name" type="text" value="{{item.name}}"
               placeholder="{{localize 'tinyd6.weapon.name'}}" spellcheck="false"/>
    </header>

    {{!-- === ТРИ КОЛОНКИ === --}}
    <div class="ws-layout">
        {{!-- 1) Характеристики --}}
        <div class="ws-core">
            <div class="ws-section-title">{{localize 'tinyd6.weapon.stats'}}</div>

            <div class="ws-row">
                <label class="ws-label">{{localize 'tinyd6.weapon.type'}}</label>
                {{#if config.enableTinyD6Plus}}
                <select class="ws-field" name="system.weaponType">
                    {{selectOptions config.weaponCombos selected=data.system.weaponType localize="true"}}
                </select>
                {{else}}
                <select class="ws-field mb-1" name="system.damageType">
                    {{selectOptions config.weaponTypes selected=data.system.damageType localize="true"}}
                </select>
                <select class="ws-field" name="system.group">
                    {{selectOptions config.weaponCategories selected=data.system.group localize="true"}}
                </select>
                {{/if}}
            </div>

            <div class="ws-row">
                <label class="ws-label">{{localize 'tinyd6.weapon.damage'}}</label>
                <input class="ws-field" type="text" name="system.damage"
                       value="{{data.system.damage}}" data-dtype="Number"/>
            </div>

            <div class="ws-row">
                <label class="ws-label">{{localize 'tinyd6.weapon.slots'}}</label>
                <input class="ws-field" type="text" name="system.slots"
                       value="{{data.system.slots}}" data-dtype="Number"/>
            </div>

            {{#if config.enableTinyD6Plus}}
                {{#if (or (eq data.system.weaponType "heavyMelee") (eq data.system.weaponType "heavyRanged"))}}
                <div class="ws-row ws-row-inline">
                    <label class="ws-toggle">
                        <input type="checkbox" name="system.oneAttack" {{checked data.system.oneAttack}}/>
                        <span>{{localize "tinyd6.weapon.oneAttack"}}</span>
                    </label>
                </div>
                {{/if}}

                {{#if (or (eq data.system.weaponType "lightRanged") (eq data.system.weaponType "heavyRanged"))}}
                <div class="ws-row ws-row-inline">
                    <label class="ws-toggle">
                        <input type="checkbox" name="system.reload" {{checked data.system.reload}}/>
                        <span>{{localize "tinyd6.weapon.reload"}}</span>
                    </label>
                </div>
                <div class="ws-row">
                    <label class="ws-label">{{localize "tinyd6.weapon.uses"}}</label>
                    <input class="ws-field" type="number" name="system.uses"
                           value="{{data.system.uses}}" min="0"/>
                </div>
                <div class="ws-row">
                    <label class="ws-label">{{localize "tinyd6.weapon.ammoType"}}</label>
                    <select class="ws-field" name="system.ammoType">
                        <option value="">{{localize "tinyd6.weapon.ammoAny"}}</option>
                        {{#each config.ammoTypes}}
                            <option value="{{this}}" {{#if (eq ../data.system.ammoType this)}}selected{{/if}}>{{this}}</option>
                        {{/each}}
                    </select>
                </div>
                {{/if}}
            {{/if}}
        </div>

        {{!-- 2) Док вкладок --}}
        <nav class="ws-dock">
            <div class="ws-dock-group">{{localize 'tinyd6.sheet.panels'}}</div>
            <button type="button" class="ws-tab active" data-tab="description">
                <i class="fas fa-book"></i>
                <span>{{localize 'tinyd6.sheet.description'}}</span>
            </button>
            {{#if moduleTabs.length}}
            <div class="ws-dock-group">{{localize 'tinyd6.sheet.modules'}}</div>
            {{#each moduleTabs}}
            <button type="button" class="ws-tab" data-tab="{{this.key}}">
                <i class="{{this.icon}}"></i>
                <span>{{this.label}}</span>
            </button>
            {{/each}}
            {{/if}}
        </nav>

        {{!-- 3) Содержимое --}}
        <div class="ws-body">
            <div class="ws-pane active" data-pane="description">
                {{editor descriptionHTML target="system.description"
                         button=true owner=owner editable=editable}}
            </div>
            {{#each moduleTabs}}
            <div class="ws-pane" data-pane="{{this.key}}"></div>
            {{/each}}
        </div>
    </div>
</form>