<form class="{{cssClass}}" autocomplete="off">
    {{> "systems/tinyd6v14/templates/partials/item-header.hbs" placeholder='tinyd6.weapon.name'}}
    <table>
        <tr>
            <th class="text-nowrap">{{localize 'tinyd6.weapon.type'}}</th>
            <th class="text-nowrap">{{localize 'tinyd6.weapon.damage'}}</th>
            <th class="text-nowrap">{{localize 'tinyd6.weapon.slots'}}</th>
        </tr>
        <tr>
            <td class="text-nowrap">
                {{#if config.enableReloadHomerule}}
                <select name="system.weaponType">
                    {{selectOptions config.weaponCombos selected=data.system.weaponType localize="true"}}
                </select>
                {{else}}
                <select name="system.damageType">
                    {{selectOptions config.weaponTypes selected=data.system.damageType localize="true"}}
                </select>
                <select name="system.group">
                    {{selectOptions config.weaponCategories selected=data.system.group localize="true"}}
                </select>
                {{/if}}
            </td>
            <td>
                <input type="text" class="text-center" name="system.damage" value="{{data.system.damage}}" dType="Number"/>
            </td>
            <td>
                <input type="text" class="text-center" name="system.slots" value="{{data.system.slots}}" dType="Number"/>
            </td>
        </tr>
    </table>

    {{#if config.enableReloadHomerule}}
    <div class="weapon-reload-opts">
        {{#if (or (eq data.system.weaponType "heavyMelee") (eq data.system.weaponType "heavyRanged"))}}
        <label class="toggle-line">
            <input type="checkbox" name="system.oneAttack" {{checked data.system.oneAttack}}/>
            {{localize "tinyd6.weapon.oneAttack"}}
        </label>
        {{/if}}

        {{#if (or (eq data.system.weaponType "lightRanged") (eq data.system.weaponType "heavyRanged"))}}
        <label class="toggle-line">
            <input type="checkbox" name="system.reload" {{checked data.system.reload}}/>
            {{localize "tinyd6.weapon.reload"}}
        </label>
        <div class="field-row">
            <label>{{localize "tinyd6.weapon.uses"}}</label>
            <input type="number" class="text-center" name="system.uses" value="{{data.system.uses}}" min="0"/>
        </div>
        {{/if}}
    </div>
    {{/if}}

    {{editor descriptionHTML target="system.description" button=true owner=owner editable=editable}}
</form>
