<div class="col left">
    {{#if showActions}}
    <button type="button" class="control-icon actions-icon" data-action="togglePalette" data-palette="actions"
            data-tooltip="tinyd6.TokenActions" data-tooltip-direction="RIGHT">
        {{{td6icon "burst"}}}
    </button>
    <div class="palette palette-actions" data-palette="actions">
        {{#if dashEnabled}}
        <div class="actions-info">
            <span class="wname">{{localize "tinyd6.sheet.actions.name"}}</span>
            <span class="charges">{{dashActionsLeft}}</span>
        </div>
        <div class="dash-row">
            <button type="button" class="wbtn dash {{#if dashed}}dashed{{/if}} {{#unless canDash}}disabled{{/unless}}"
                    data-action="dash"
                    data-tooltip="{{#if dashed}}{{#if dashCanUndo}}{{localize "tinyd6.movement.dashUndo"}}{{else}}{{localize "tinyd6.movement.dashOff"}}{{/if}}{{else}}{{localize "tinyd6.movement.dashHint"}}{{/if}}"
                    data-tooltip-direction="DOWN"
                    {{#unless canDash}}disabled{{/unless}}>
                {{#if dashed}}{{localize "tinyd6.movement.dashActive"}}{{else}}{{localize "tinyd6.movement.dash"}}{{/if}} {{{td6icon "run"}}}
            </button>
        </div>
        {{/if}}
        {{#if showStab}}
        <div class="wcard hcard stab">
            <div class="whead">
                <img src="{{healIcon}}" alt="">
                <span class="wname">{{localize "tinyd6.stabilize.title"}}</span>
                <span class="charges" style="color:#6ea8fe;">0 HP</span>
            </div>
            <div class="whead" style="margin-top:2px;">
                <button type="button" class="wbtn stab {{#unless stabUsable}}disabled{{/unless}}" data-action="stabilize"
                        data-tooltip="{{localize 'tinyd6.stabilize.sheetHint'}} · {{localize 'tinyd6.stabilize.actionsCost'}}" data-tooltip-direction="DOWN"
                        {{#unless stabUsable}}disabled{{/unless}}>
                    {{localize "tinyd6.stabilize.title"}} {{{td6icon "burst"}}}
                </button>
            </div>
        </div>
        {{/if}}
        {{#each healItems as |heal|}}
        <div class="wcard hcard" data-heal-id="{{heal.id}}">
            <div class="whead">
                <img src="{{heal.img}}" alt="{{heal.name}}">
                <span class="wname" title="{{heal.name}}">{{heal.name}}</span>
                <span class="charges {{#if (eq heal.qty 0)}}empty{{/if}}">+{{heal.heal}} · ×{{heal.qty}}</span>
            </div>
            <div class="whead">
                <button type="button" class="wbtn heal {{#if (eq heal.qty 0)}}empty{{/if}}" data-action="healUse"
                        data-tooltip="tinyd6.heal.useTooltip" data-tooltip-direction="DOWN"
                        {{#if (eq heal.qty 0)}}disabled{{/if}}>
                    {{localize "tinyd6.heal.use"}} {{{td6icon "heart-pulse"}}}
                </button>
            </div>
        </div>
        {{/each}}
        {{#unless hasHealItems}}
        <div class="wcard hcard">
            <div class="whead">
                <span class="wname">{{localize "tinyd6.heal.emptyHint"}}</span>
            </div>
        </div>
        {{/unless}}
    </div>
    {{/if}}

    {{#if showWeapons}}
    <button type="button" class="control-icon" data-action="togglePalette" data-palette="weapons"
            data-tooltip="tinyd6.TokenWeapons" data-tooltip-direction="RIGHT">
        {{{td6icon "crosshairs"}}}
    </button>
    <div class="palette palette-weapons" data-palette="weapons">
        {{#each weapons as |weapon|}}
        <div class="wcard {{#if weapon.empty}}weapon-empty{{/if}}" data-weapon-id="{{weapon.id}}">
            <div class="whead">
                <img src="{{weapon.img}}" alt="{{weapon.name}}">
                <span class="wname" title="{{weapon.name}}">{{weapon.name}}</span>
                {{#if weapon.reload}}<span class="charges {{#if weapon.empty}}empty{{/if}}">{{weapon.charges}}/{{weapon.uses}}</span>{{/if}}
            </div>
            <div class="wactions">
                <button type="button" class="wbtn attack {{#if weapon.empty}}empty{{/if}}"
                        data-action="weaponAttack" title="{{localize "tinyd6.Attack"}}">
                    {{localize "tinyd6.Attack"}} {{{td6icon "burst"}}}
                </button>
                {{#if weapon.reload}}
                <button type="button" class="wbtn reload" data-action="weaponReload" title="{{localize "tinyd6.Reload"}}">
                    {{localize "tinyd6.Reload"}} {{{td6icon "rotate-right"}}}
                </button>
                {{/if}}
            </div>
        </div>
        {{/each}}
    </div>
    {{/if}}

    {{#if canConfigure}}
    <button type="button" class="control-icon" data-action="config" data-tooltip="HUD.OpenConfig">
        {{{td6icon "gear"}}}
    </button>
    {{/if}}
</div>

<div class="col middle">
    <div class="attribute hp-rail">
        <button type="button" class="hp-stepper minus" data-action="hpStep" data-step="-1"
                {{#unless hpEditable}}disabled{{/unless}} title="-1 HP">{{{td6icon "minus"}}}</button>
        <span class="hp-heart">{{{td6icon "heart-pulse"}}}</span>
        <input type="text" name="bar1" class="hp-value" value="{{bar1Data.value}}" max="{{hpMax}}"
               {{#unless bar1Data.editable}}disabled{{/unless}}>
        <button type="button" class="hp-stepper plus" data-action="hpStep" data-step="1"
                {{#unless hpEditable}}disabled{{/unless}} title="+1 HP">+</button>
    </div>

    {{#if showArmor}}
    <div class="attribute">
        <div class="armor-box" data-tooltip="tinyd6.TokenArmor" data-tooltip-direction="UP">
            <img class="armor-icon" src="{{armorIcon}}" inert>
            <input type="number" step="any" min="0" data-edit-attr="dr" title="DR"
                   value="{{armorTotal}}" {{disabled (not armorEditable)}}>
            <input type="number" step="any" min="0" data-edit-attr="hp" title="Armor HP"
                   value="{{armorHpTotal}}" {{disabled (not armorEditable)}}>
        </div>
    </div>
    {{/if}}

    {{#if deathChip}}
    <div class="attribute">
        <span class="death-chip {{deathChip.state}}" title="{{deathChip.tooltip}}">
            {{{td6icon deathChip.icon}}} {{deathChip.label}}
        </span>
    </div>
    {{/if}}
</div>

<div class="col right">
    {{#if isGM}}
    <button type="button" class="control-icon {{visibilityClass}}" data-action="visibility" data-tooltip="HUD.ToggleVis">
        <img src="{{icons.visibility}}">
    </button>
    {{/if}}

    <button type="button" class="control-icon" data-action="togglePalette" data-palette="effects" data-tooltip="HUD.AssignStatusEffects">
        <img src="{{icons.effects}}">
    </button>
    <div class="palette status-effects" data-palette="effects">
        {{#each statusEffects as |status|}}
        <img class="effect-control {{status.cssClass}}" src="{{status.src}}" data-action="effect"
             {{#if status.title}}data-tooltip-text="{{status.title}}"{{/if}} data-status-id="{{status.id}}">
        {{/each}}
    </div>

    <button type="button" class="control-icon {{targetClass}}" data-action="target" data-tooltip="HUD.ToggleTargetState">
        {{{td6icon "bullseye"}}}
    </button>

    {{#if canToggleCombat}}
    <button type="button" class="control-icon {{combatClass}}" data-action="combat" data-tooltip="HUD.ToggleCombatState">
        <img src="{{icons.combat}}">
    </button>
    {{/if}}
</div>
