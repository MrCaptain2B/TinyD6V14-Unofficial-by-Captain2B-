<{{#if tagName}}{{tagName}}{{^}}li{{/if}} class="{{classes}} actor-item" data-item-id="{{gearItem._id}}">
<div class="d-flex justify-content-between">
    <img src="{{gearItem.img}}" title="{{gearItem.name}}" width="24" height="24" class="align-middle mr-2"/>
    <h4 class="mr-auto">
        {{#if (eq gearItem.type "gear")}}
            {{#if (eq gearItem.system.category "money")}}
                <div class="gear-money">
                    <div class="money-value-row">
                        <i class="fas fa-coins"></i>
                        {{#if owner}}
                            <input class="money-input" type="number" min="0" step="1" value="{{gearItem.system.quantity.value}}" data-item-id="{{gearItem._id}}"/>
                        {{^}}
                            <span class="money-value">{{gearItem.system.quantity.value}}</span>
                        {{/if}}
                    </div>
                    <a class="money-name item-show d-inline-block">{{gearItem.name}}</a>
                </div>
            {{^}}
                <a class="item-show d-inline-block h-100">{{gearItem.name}}</a>
                {{#if (eq gearItem.system.category "ammo")}}
                    <span class="gear-cat ammo">{{gearItem.system.ammoType}} · ×{{gearItem.system.quantity.value}}</span>
                {{/if}}
                {{#if (eq gearItem.system.category "heal")}}
                    <span class="gear-cat heal">{{gearItem.system.heal}} HP · ×{{gearItem.system.quantity.value}}</span>
                {{/if}}
            {{/if}}
        {{^}}
            <a class="item-show d-inline-block h-100">{{gearItem.name}}</a>
        {{/if}}
    </h4>    {{#if (eq gearItem.type "weapon")}}
        <a class="item-control item-equip ml-2 {{#if gearItem.system.equipped}}equipped{{/if}}" data-field="system.equipped" title="{{localize "tinyd6.actor.actions.equipTrait"}}">
            <span class="fas fa-tshirt"></span>
        </a>
    {{/if}}
    {{#if (eq gearItem.type "armor")}}
        <a class="item-control item-equip ml-2 {{#if gearItem.system.equipped}}equipped{{/if}}" data-field="system.equipped" title="{{localize "tinyd6.actor.actions.equipTrait"}}">
            <span class="fas fa-tshirt"></span>
        </a>
    {{/if}}
    <a class="item-chat ml-2" title="{{localize "tinyd6.actor.actions.chatItem"}}"><i class="fas fa-comment-dots"></i></a>
    {{#if (eq gearItem.system.category "heal")}}
    <a class="item-control item-use ml-2" data-item-id="{{gearItem._id}}" title="{{localize "tinyd6.heal.use"}}"><i class="fas fa-kit-medical"></i></a>
    {{/if}}
    <a class="item-control item-delete ml-2" title="{{localize "tinyd6.actor.actions.deleteTrait"}}"><i class="fas fa-times"></i></a>
</div>
</{{#if tagName}}{{tagName}}{{^}}li{{/if}}>
