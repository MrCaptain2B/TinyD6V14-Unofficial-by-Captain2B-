<div class="tinyd6 item-card" data-item-id="{{item._id}}">
    <div class="item-card-head d-flex align-items-start">
        <img src="{{img}}" alt="{{name}}" width="36" height="36" class="align-middle mr-2"/>
        <div class="w-100">
            <h3 class="item-card-name m-0">{{name}}</h3>
            <div class="item-card-type">{{item.type}}</div>
        </div>
    </div>
    {{#if traitHTML}}
    <div class="item-card-trait">
        <div class="item-card-trait-label">{{localize "tinyd6.heritage.trait"}}</div>
        <div class="item-card-trait-body">{{{traitHTML}}}</div>
    </div>
    {{/if}}
    <div class="item-card-body">
        {{{descriptionHTML}}}
    </div>
</div>
